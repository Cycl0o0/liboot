# Relocatable from <prefix>/<libdir>/pkgconfig, including multi-component
# libdirs and a `cmake --install --prefix` override.
prefix=${pcfiledir}/@LIBOOT_PC_PREFIX_RELATIVE@
exec_prefix=${prefix}
libdir=${pcfiledir}/..
includedir=@LIBOOT_PC_INCLUDEDIR@

Name: liboot
Description: @PROJECT_DESCRIPTION@
URL: @PROJECT_HOMEPAGE_URL@
Version: @PROJECT_VERSION@
Libs: -L"${libdir}" -loot
Libs.private: @LIBOOT_PC_PRIVATE_LIBS@
Cflags: -I"${includedir}"
